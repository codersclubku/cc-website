# Staging Environment Configuration Template
# Copy this file to .env.staging.local and fill in your isolated staging credentials.
# Do NOT fill with production credentials!

STAGING_SUPABASE_URL=https://<your-staging-ref>.supabase.co
STAGING_ANON_KEY=your-staging-anon-key-here
STAGING_SERVICE_ROLE_KEY=your-staging-service-role-key-here

